{
  "manifest_version": 3,
  "name": "Pixel Explorer",
  "version": "1.0.0",
  "description": "Explore a pixel world while summarizing web pages",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pixel Explorer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
